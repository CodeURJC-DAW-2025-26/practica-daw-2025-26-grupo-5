{
  "info": {
    "name": "Stilnovo API v1",
    "description": "Coleccion de ejemplo para probar la API REST de la Practica 2. Configura la variable de entorno {{baseUrl}} (por ejemplo: https://localhost:8443).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Signup",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Main",
      "item": [
        {
          "name": "Home Data",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/main?query=&category=&page=0&size=10"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products?query=&category=&page=0&size=10"
          }
        },
        {
          "name": "Recommendations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/recommendations"
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/1"
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Desk Lamp", "type": "text" },
                { "key": "category", "value": "home", "type": "text" },
                { "key": "price", "value": "49.99", "type": "text" },
                { "key": "location", "value": "Madrid", "type": "text" },
                { "key": "description", "value": "Modern lamp", "type": "text" },
                { "key": "status", "value": "Active", "type": "text" },
                { "key": "files", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/v1/products"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Desk Lamp Updated", "type": "text" },
                { "key": "category", "value": "home", "type": "text" },
                { "key": "price", "value": "59.99", "type": "text" },
                { "key": "location", "value": "Madrid", "type": "text" },
                { "key": "description", "value": "Updated description", "type": "text" },
                { "key": "status", "value": "Active", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/products/1"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/products/1"
          }
        }
      ]
    },
    {
      "name": "Product Info",
      "item": [
        {
          "name": "Info Product By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/info-products/1"
          }
        }
      ]
    },
    {
      "name": "Images",
      "item": [
        {
          "name": "List Product Images",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/images/products/1"
          }
        },
        {
          "name": "Get Image Binary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/images/1/file"
          }
        },
        {
          "name": "Upload Product Images",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "src": [] },
                { "key": "files", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/v1/images/products/1"
          }
        }
      ]
    },
    {
      "name": "Users",
