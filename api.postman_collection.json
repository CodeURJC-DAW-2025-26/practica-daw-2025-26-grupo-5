          "name": "Seller Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/users/1/seller-profile"
          }
        },
        {
          "name": "Update My Settings",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "newEmail", "value": "user1@stilnovo.es", "type": "text" },
                { "key": "newDescription", "value": "Updated profile from REST", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/users/me/settings"
          }
        },
        {
          "name": "Delete My Account",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        }
      ]
    },
